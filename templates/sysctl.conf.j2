# {{ ansible_managed }}
# Kernel settings for the DNS resolver.

# Larger socket buffers for QUIC (DNS-over-QUIC) and busy UDP sockets.
net.core.rmem_max = 8388608
net.core.wmem_max = 8388608
net.core.rmem_default = 1048576
net.core.wmem_default = 1048576

# Longer accept queues for DoT and DoH.
net.core.somaxconn = 4096
net.ipv4.tcp_max_syn_backlog = 8192

# BBR congestion control with fq.
net.core.default_qdisc = fq
net.ipv4.tcp_congestion_control = bbr

# Let the metrics endpoints bind to an address that appears later, such as a
# VPN address, so the DNS services never wait for it.
net.ipv4.ip_nonlocal_bind = 1
net.ipv6.ip_nonlocal_bind = 1

# {{ ansible_managed }}
[Unit]
Description=Hickory DNS recursive resolver
Documentation=https://github.com/unredacted/ansible-role-dns-resolver
Requires=dns-resolver-firewall.service
After=dns-resolver-firewall.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=exec
User={{ dns_resolver_hickory_user }}
Group={{ dns_resolver_hickory_user }}
ExecStart=/usr/local/sbin/hickory-dns --config /etc/hickory/named.toml
# Request-path modules log query names and client addresses, even at WARN.
# Keep only the program's own start and stop lines.
Environment=RUST_LOG={{ dns_resolver_hickory_log_filter }}
Restart=always
RestartSec=2

# Logs: own journal namespace, warnings and errors only.
LogNamespace={{ dns_resolver_journal_namespace }}
LogLevelMax=warning

# Resources.
LimitNOFILE=1048576
LimitCORE=0
MemoryHigh={{ dns_resolver_hickory_memory_high }}
MemoryMax={{ dns_resolver_hickory_memory_max }}
MemorySwapMax=0
TasksMax={{ dns_resolver_hickory_tasks_max }}

# Sandbox.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
UMask=0077
StateDirectory=hickory
StateDirectoryMode=0700
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target

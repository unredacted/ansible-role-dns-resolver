# {{ ansible_managed }}
# Settings for dns-resolver-cert. Values already in the environment win, so a
# one-off run can override them (for example RENEW_DAYS=999 to force renewal).
TLS_DIR=${TLS_DIR:-{{ dns_resolver_tls_dir }}}
LEGO_PATH=${LEGO_PATH:-{{ dns_resolver_lego_path }}}
HOSTNAMES="${HOSTNAMES:-{{ dns_resolver_hostnames | join(' ') }}}"
LISTEN_ADDRESSES="${LISTEN_ADDRESSES:-{{ (dns_resolver_listen_v4 + dns_resolver_listen_v6) | join(' ') }}}"
SERVICE_USER=${SERVICE_USER:-{{ dns_resolver_hickory_user }}}
CA_BUNDLE=${CA_BUNDLE:-{{ dns_resolver_tls_ca_bundle }}}
METRICS_DIR=${METRICS_DIR:-{{ dns_resolver_textfile_dir }}}
DOT_PORT=${DOT_PORT:-{{ dns_resolver_dot_port }}}
DOQ_PORT=${DOQ_PORT:-{{ dns_resolver_doq_port }}}
DOH_PORT=${DOH_PORT:-{{ dns_resolver_doh_port }}}
ACME_SERVER=${ACME_SERVER:-{{ dns_resolver_acme_server }}}
ACME_EMAIL=${ACME_EMAIL:-{{ dns_resolver_acme_email }}}
ACME_PROVIDER=${ACME_PROVIDER:-{{ dns_resolver_acme_provider }}}
ACME_KEY_TYPE=${ACME_KEY_TYPE:-{{ dns_resolver_acme_key_type }}}
ACME_DNS_RESOLVERS="${ACME_DNS_RESOLVERS:-{{ dns_resolver_acme_dns_resolvers | join(' ') }}}"
ACME_DISABLE_CP=${ACME_DISABLE_CP:-{{ dns_resolver_acme_disable_propagation_check | bool | lower }}}
ACME_DISABLE_CP=${ACME_DISABLE_CP:-{{ dns_resolver_acme_disable_propagation_check | bool | lower }}}
RENEW_DAYS=${RENEW_DAYS:-{{ dns_resolver_acme_renew_days }}}

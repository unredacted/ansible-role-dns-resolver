# {{ ansible_managed }}
# Settings and secrets for the ACME DNS provider. Readable by root only.
{% set hook = {'EXEC_PATH': '/usr/local/libexec/dns-resolver/acme-hooks/' ~ dns_resolver_acme_exec_hook ~ '.py'} if dns_resolver_acme_exec_hook else {} %}
{% for key, value in (dns_resolver_acme_env | combine(hook)) | dictsort %}
{{ key }}={{ value | string | quote }}
{% endfor %}
